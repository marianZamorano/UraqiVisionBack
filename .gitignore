# Secretos (RNF-06): el .env es solo local; se versiona únicamente .env.example (y los .env.<x>.example de los
# entornos declarados en package.json → uraqi.envPermitidos), sin credenciales.
.env
.env.*
!.env.example
!.env.*.example
.netrc
_netrc
*.pem
*.key

# Configuración personal de los asistentes de IA
.claude/settings.local.json
.gemini/.env

# Dependencias y artefactos
node_modules/
dist/
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Exploración NISAR (#60): archivos que crea earthaccess y salidas de datos locales (RNF-06)
.dodsrc
.urs_cookies
datos/
