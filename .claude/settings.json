{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.netrc)",
      "Read(./**/_netrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(vercel *)",
      "PowerShell(vercel *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(npm run pr:aprobar*)",
      "PowerShell(npm run pr:aprobar*)",
      "Bash(npm run pr:fusionar*)",
      "PowerShell(npm run pr:fusionar*)",
      "Bash(node ai/scripts/prs.mjs aprobar*)",
      "PowerShell(node ai/scripts/prs.mjs aprobar*)",
      "Bash(node ai/scripts/prs.mjs fusionar*)",
      "PowerShell(node ai/scripts/prs.mjs fusionar*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ai/hooks/session-context.mjs\" --platform=claude",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ai/hooks/prompt-guard.mjs\" --platform=claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ai/hooks/pre-tool.mjs\" --platform=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ai/hooks/post-edit.mjs\" --platform=claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
