{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "node",
        "ai/mcp/launch.mjs",
        "context7"
      ],
      "enabled": true
    },
    "qa-evidence": {
      "type": "local",
      "command": [
        "node",
        "ai/qa/mcp-servers/qa-evidence/server.mjs"
      ],
      "enabled": true
    },
    "devops-readiness": {
      "type": "local",
      "command": [
        "node",
        "ai/devops/mcp-servers/devops-readiness/server.mjs"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "npm publish*": "deny",
      "vercel*": "ask",
      "npm run pr:aprobar*": "ask",
      "npm run pr:fusionar*": "ask",
      "node ai/scripts/prs.mjs aprobar*": "ask",
      "node ai/scripts/prs.mjs fusionar*": "ask"
    }
  }
}
